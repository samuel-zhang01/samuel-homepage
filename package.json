{
  "name": "samuel-homepage",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.16.0"
  },
  "scripts": {
    "prepare:pdfjs": "node scripts/prepare-pdfjs-assets.mjs",
    "predev": "npm run prepare:pdfjs",
    "dev": "next dev",
    "predev:lan": "npm run prepare:pdfjs",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 5174",
    "check:artifacts": "node scripts/check-project-artifacts.mjs",
    "check:data": "node scripts/check-project-csv-fixtures.mjs",
    "check:desk": "node scripts/check-desk-behavior.mjs",
    "check:controls": "node scripts/check-classic-select.mjs",
    "check:orbitals": "node scripts/check-orbitals.mjs",
    "check:catalogue": "node scripts/check-project-catalogue.mjs",
    "check:styles": "node scripts/check-project-css-modules.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "check:output": "node scripts/check-build-output.mjs",
    "audit:dependencies": "npm audit --audit-level=moderate && npm audit signatures",
    "prebuild": "npm run prepare:pdfjs && npm run check:artifacts && npm run check:data && npm run check:desk && npm run check:controls && npm run check:orbitals && npm run check:catalogue && npm run check:styles && npm run check:locales",
    "build": "next build",
    "postbuild": "npm run check:output",
    "build:isolated": "npm run prepare:pdfjs && npm run check:artifacts && npm run check:data && npm run check:desk && npm run check:controls && npm run check:orbitals && npm run check:catalogue && npm run check:styles && npm run check:locales && NEXT_DIST_DIR=.next-build next build && node scripts/check-build-output.mjs .next-build",
    "check:release": "npm run audit:dependencies && npm run lint && npm run build:isolated",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "15.5.22",
    "pdfjs-dist": "5.4.624",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "opencc-js": "^1.4.2",
    "typescript": "^5"
  }
}
