# Safe deployment endpoints only — never put credentials, certificates or
# Cloudflare tokens in this repository.
#
# On the production LAN host, bind specifically to its LAN address. The
# default in docker-compose.yml is 0.0.0.0, which also permits trusted LAN
# access when no explicit address is supplied.
HOMEPAGE_BIND_ADDRESS=192.168.1.200
HOMEPAGE_PORT=5174

# Canonical public identity used by deploy.sh for a same-origin probe and an
# optional HTTPS verification (VERIFY_PUBLIC_ORIGIN=1 ./deploy.sh).
HOMEPAGE_PUBLIC_ORIGIN=https://me.samuelzhang.co.uk
